# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Email (Gmail) ──────────────────────────────────────────────────────────────
RSS2MAIL_EMAIL=yourname@gmail.com
RSS2MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Facebook Messenger (optional) ─────────────────────────────────────────────
RSS2MAIL_MESSENGER_TOKEN=
RSS2MAIL_MESSENGER_RECIPIENT_ID=

# ── Database path (Docker only — leave blank for local dev) ───────────────────
# RSS2MAIL_DB_PATH=/data/rss2mail.db
